# Copy to .env and fill in. .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# docker/docker-compose.yml default credentials for local dev
DATABASE_URL=postgresql://trader:trader_dev_password@localhost:5432/trader

# Sign up at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Free tier, sign up at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Which MarketDataProvider apps/api uses: "alpha-vantage" (free, good US coverage,
# 25 req/day cap) or "eodhd" (paid, ~$20/mo, broader coverage including mainland
# China — Shanghai/Shenzhen — and Hong Kong, which alpha-vantage barely reaches).
MARKET_DATA_PROVIDER=alpha-vantage

# Only needed if MARKET_DATA_PROVIDER=eodhd. Sign up at https://eodhd.com/pricing
EODHD_API_KEY=

# Hard daily ceiling enforced by the AI orchestrator (USD)
AI_DAILY_BUDGET_USD=2
